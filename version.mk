VER_MAJOR=1
VER_MINOR=4
VER_RELEASE=0
VER_BUILD=0

# Marks everything built from this fork as a community build. It reaches the
# version string the game reports and the log header, so a screenshot or a bug
# report cannot be mistaken for an official KeeperFX release. The official
# workflows pass their own value on the command line, which wins over this.
PACKAGE_SUFFIX=Unofficial