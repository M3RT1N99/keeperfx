<?xml version="1.0" encoding="utf-8"?>
<!--
  Arranged the way the desktop Qt launcher is: the Dungeon Keeper land view
  behind a dark scrim, one big Play button as the hero action, and the utilities
  (log file, folder, reset) as a row of small icon buttons underneath it. Colours
  and icons come from keeperfx-launcher-qt, which is GPL v2 like this repository.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kfx_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_landscape" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kfx_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Title bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/kfx_accent"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/kfx_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/keeperfxStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/kfx_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/originalDkStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/kfx_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/kfx_text_dim"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Getting the data in place -->
            <Button
                android:id="@+id/installKeeperfx"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_orange"
                android:drawableStart="@drawable/ic_update"
                android:drawablePadding="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/button_install_keeperfx"
                android:textColor="@color/btn_text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/importOriginalDk"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_orange"
                android:drawableStart="@drawable/ic_folder"
                android:drawablePadding="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/button_import_original"
                android:textColor="@color/btn_text"
                android:textSize="15sp" />

            <!-- Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/settings_controls"
                android:textColor="@color/kfx_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="10dp">

                <RadioGroup
                    android:id="@+id/inputMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/inputAuto"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="@string/input_auto"
                        android:textColor="@color/kfx_text" />

                    <RadioButton
                        android:id="@+id/inputTouch"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="@string/input_touch"
                        android:textColor="@color/kfx_text" />

                    <RadioButton
                        android:id="@+id/inputPointer"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="@string/input_pointer"
                        android:textColor="@color/kfx_text" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/backButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/option_back_button"
                    android:textColor="@color/kfx_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/input_gestures"
                    android:textColor="@color/kfx_text_dim"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings_data"
                android:textColor="@color/kfx_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="10dp">

                <CheckBox
                    android:id="@+id/useAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/option_use_alpha"
                    android:textColor="@color/kfx_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/option_use_alpha_hint"
                    android:textColor="@color/kfx_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings_language"
                android:textColor="@color/kfx_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="10dp">

                <Spinner
                    android:id="@+id/language"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_language_hint"
                    android:textColor="@color/kfx_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings_startup"
                android:textColor="@color/kfx_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="10dp">

                <CheckBox
                    android:id="@+id/noIntro"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/option_no_intro"
                    android:textColor="@color/kfx_text" />

                <CheckBox
                    android:id="@+id/noSound"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/option_no_sound"
                    android:textColor="@color/kfx_text" />

                <EditText
                    android:id="@+id/extraArgs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/option_extra_args"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textColor="@color/kfx_text"
                    android:textColorHint="@color/kfx_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Hero action -->
            <Button
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/btn_orange"
                android:text="@string/button_play"
                android:textColor="@color/btn_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!--
              Utility row, as in the desktop launcher. The reset sits at the far
              end, deliberately not next to the log button it would otherwise be
              easy to hit by accident, and carries the outlined danger style.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/showLog"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_slate"
                    android:drawableStart="@drawable/ic_logfile"
                    android:drawablePadding="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/button_log"
                    android:textColor="@color/btn_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/importKeeperfx"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_slate"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawablePadding="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/button_import_keeperfx"
                    android:textColor="@color/btn_text"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/removeData"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_danger"
                    android:text="@string/button_remove"
                    android:textColor="@color/btn_danger_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <!--
              The app updates itself, so this is the one thing no other part of
              the system will ever offer. It carries the running version, which
              is also the answer to "which build am I on".
            -->
            <Button
                android:id="@+id/updateApp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/btn_slate"
                android:drawableStart="@drawable/ic_update"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/button_update_app"
                android:textColor="@color/btn_text"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
