<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kfx_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/kfx_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/kfx_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/kfx_text_dim"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/importData"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/button_import" />

            <Button
                android:id="@+id/removeData"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/button_remove" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/kfx_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_controls"
            android:textColor="@color/kfx_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/inputMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/inputAuto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/input_auto"
                android:textColor="@color/kfx_text" />

            <RadioButton
                android:id="@+id/inputTouch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/input_touch"
                android:textColor="@color/kfx_text" />

            <RadioButton
                android:id="@+id/inputPointer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/input_pointer"
                android:textColor="@color/kfx_text" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/input_gestures"
            android:textColor="@color/kfx_text_dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_startup"
            android:textColor="@color/kfx_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/noIntro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/option_no_intro"
            android:textColor="@color/kfx_text" />

        <CheckBox
            android:id="@+id/noSound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/option_no_sound"
            android:textColor="@color/kfx_text" />

        <EditText
            android:id="@+id/extraArgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/option_extra_args"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/kfx_text"
            android:textColorHint="@color/kfx_text_dim" />

        <Button
            android:id="@+id/play"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/button_play"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
