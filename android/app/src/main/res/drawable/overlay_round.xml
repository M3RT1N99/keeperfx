<?xml version="1.0" encoding="utf-8"?>
<!--
  Background of the in game overlay buttons. Deliberately dark and thin: it
  sits on top of the rendered game, so it has to read as an addition rather
  than as part of the dungeon.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/kfx_accent" />
            <stroke
                android:width="1dp"
                android:color="@color/kfx_panel_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/kfx_scrim" />
            <stroke
                android:width="1dp"
                android:color="@color/kfx_panel_stroke" />
        </shape>
    </item>
</selector>
