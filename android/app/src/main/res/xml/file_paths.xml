<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the copy of the log that the share action writes is exposed. -->
    <cache-path name="shared-logs" path="shared-logs/" />
    <!--
      And the downloaded APK, which is handed to the system installer. It lives
      under files/ rather than the cache so that a partial download is not
      thrown away by the system part way through.
    -->
    <files-path name="updates" path="updates/" />
    <!--
      And an installation packed for another phone, which is read by whatever the
      player shares it with, long after the share sheet has closed again.
    -->
    <files-path name="exports" path="exports/" />
</paths>
