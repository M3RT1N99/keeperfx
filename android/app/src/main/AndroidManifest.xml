<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Games on the local network find each other by broadcasting. Wi-Fi hardware
      drops packets that are not addressed to the device unless a multicast lock
      is held, so without this the game list stays empty on both ends. GameActivity
      holds the lock only while playing.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      The app is sideloaded, so nothing else will ever offer it a newer build.
      This lets the launcher hand a downloaded APK to the system installer; the
      player still has to confirm both the one-off permission and the install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Downloads keep running when the launcher is closed, and a network game when
      a call comes in. A foreground service is the only supported way to do either,
      and it needs a visible notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Touch is the primary input, but a keyboard, mouse or pad may be attached. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!--
      appCategory tells the platform this is a game. Samsung's and Google's
      game services key off it: the scheduler treats the process as a game,
      Game Booster manages thermals for it, and notifications stay out of the
      way. Without it the engine is just an anonymous CPU-heavy app, first in
      line for throttling.
    -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeeperFX">

        <!--
          Handles rotation and the like itself: its layout is the same either way, and
          being recreated would cancel a folder import that is running. The keyboard
          resizes it, so that Play rides above the keyboard and the scrolling part brings
          the field being typed in between them. Left unspecified this would pan: a
          ScrollView without scrollbars does not count as something that can resize.
        -->
        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/log_title"
            android:parentActivityName=".LauncherActivity" />

        <activity
            android:name=".TouchTuningActivity"
            android:exported="false"
            android:label="@string/tuning_title"
            android:parentActivityName=".LauncherActivity" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- In the engine's process, see GameActivity below: it is there to keep that one alive. -->
        <service
            android:name=".NetworkGameService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":game" />

        <!-- Hands out the shared log copy, the downloaded APK and a packed installation, nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          SDLActivity expects to own the process, so it gets one: SDL ends the process
          when a second activity is started in it, and a process ending that way or by a
          native crash must not take the launcher and what it is doing with it. launchMode
          singleInstance and the configChanges list follow SDL's own android-project template.
        -->
        <activity
            android:name=".GameActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:preferMinimalPostProcessing="true"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.KeeperFX.Game" />
    </application>
</manifest>
