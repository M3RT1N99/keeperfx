<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Games on the local network announce themselves by broadcasting to
      255.255.255.255. Wi-Fi hardware drops packets that are not addressed to
      the device unless a multicast lock is held, so without this the game list
      stays empty on both ends. GameActivity holds the lock only while playing.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!--
      The app is sideloaded, so nothing else will ever offer it a newer build.
      This lets the launcher hand a downloaded APK to the system installer; the
      player still has to confirm both the one-off permission and the install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Downloads keep running when the launcher is closed. A foreground service
      is the only supported way to do that, and it needs a visible notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Touch is the primary input, but a keyboard, mouse or pad may be attached. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!--
      appCategory tells the platform this is a game. Samsung's and Google's
      game services key off it: the scheduler treats the process as a game,
      Game Booster manages thermals for it, and notifications stay out of the
      way. Without it the engine is just an anonymous CPU-heavy app, first in
      line for throttling.
    -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.KeeperFX">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/log_title"
            android:parentActivityName=".LauncherActivity" />

        <activity
            android:name=".TouchTuningActivity"
            android:exported="false"
            android:label="@string/tuning_title"
            android:parentActivityName=".LauncherActivity" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hands out the shared log copy and the downloaded APK, nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          SDLActivity expects to own the process; launchMode singleInstance and
          the configChanges list follow SDL's own android-project template.
        -->
        <activity
            android:name=".GameActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.KeeperFX.Game" />
    </application>
</manifest>
